[Unit]
Description=Die Werkbank - private Minecraft-Statistiken
After=network-online.target create-exporter.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/nicma/servers/tools
ExecStart=/usr/bin/python3 -I /home/nicma/servers/tools/web/server.py --bind 0.0.0.0 --port 8088 --chat-limit 5 --chat-window 30 --chat-global-limit 20
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
MemoryMax=160M
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=default.target
